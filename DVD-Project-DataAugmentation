ages', 'Sanitary Napkins','Tampons & Menstrual Cups', 'Sexual Wellness', 'Panty Liners', 'Adult Diapers'],\n","      'Wellness': ['Supplements & Proteins','Everyday Medicine', 'Ayurveda']\n","      #'Ears': []\n","  }\n","\n","  parts = {\n","          'Lips': ['Lip'],\n","          'Mouth':['Tooth', 'Teeth', 'Oral'],\n","          'Eyes': ['Eye'],\n","          'Hand': ['Hand', 'Nail'],\n","          'Face': ['Face','Shaving','Beard','Moustache','Glycerin', 'Makeup'],\n","          'Hair': ['Hair', 'Scalp'],\n","          'Body': ['Deo', 'Skin', 'Eau', 'Perfume', 'Talc', 'Grooming', 'Balm', 'Joint', 'Spray','Antiseptic','Pain Relief','Vaporub','Ointment','Neem Oil','Castor Oil','Eucalyptus Oil','Cotton Wool','Relispray', 'Body'],\n","          'Wellness': ['Supplement','Tablet','Capsule','Cough','Inhaler','Ayurveda'],\n","          'Feet': ['Feet','Foot', 'Leg'],\n","          'Private Hygiene': ['Diapers', 'Hygiene', 'Sanitary', 'Sexual'],\n","          'Ears': ['Ear']\n","          }\n","\n","  try:\n","    item = data['product_subcategory'] + ' ' + data['product_type'] + ' ' + data['product_title'] + ' ' + str(data['product_description'])\n","  except:\n","    item = ''\n","\n","  # if data['product_type'] == 'Ayurveda':\n","  #   if re.search(\"['oil'|'thailam'|'taila'|tailam|balm|scrub]\",data['product_title'].lower()):\n","  #     return 'Body'\n","  #   else:\n","  #     return 'Internal'\n","\n","  for part in parts_producttype:\n","    if data['product_type'] in parts_producttype[part]:\n","      return part\n","  for part in parts.keys():\n","    for text in parts[part]:\n","      pattern = r\"\\b\" + re.escape(text.lower())# + r\"\\b\"\n","      if re.search(pattern, item.lower()):\n","          return part\n","  return 'Others'\n","\n","# Find Form\n","def find_form(data):\n","  forms = {\n","          'Oils': ['Hair oil'],\n","          'Tablets & Powders': ['Tablet', 'Capsule', 'Ayurveda', 'Supplement'],\n","          'Sexual Wellness': ['Condom', 'Sexual'],\n","          'Diapers & Napkins': ['Diaper', 'Sanitary Napkin', 'Tampon'],\n","          'Oral care': ['Toothbrush', 'Oral'],\n","          'Deodorants & Perfumes': ['Deo', 'Perfume', 'Eau', 'Talcum'],\n","          'Soaps & Shampoos': ['Bath', 'Wash', 'Shampoo', 'Conditioners', 'Scrub', 'Sanitizer'],\n","          'Creams & Lotions':['Cream', 'Moisturiser', 'Lotion', 'Skin care', 'Hair removal', 'Creme', 'Hair Care', 'Toothpaste', 'Makeup'],\n","          'Shaving & Styling': ['Shaving', 'Grooming', 'Styling', 'Comb'],\n","          'Masks': ['Face Mask'],\n","          'Spray': ['Spray'],\n","          'Cotton': ['Cotton']\n","          }\n","  try:\n","    item = data['product_subcategory'] + ' ' + data['product_type'] + ' ' + data['product_title'] + ' ' + str(data['product_description'])\n","  except:\n","    item = ''\n","  for form in forms.keys():\n","    for text in forms[form]:\n","      pattern = r\"\\b\" + re.escape(text.lower())\n","      if re.search(pattern, item.lower()):\n","          # if form == 'Masks':\n","          #   print(item)\n","          return form\n","  #print(item)\n","  return 'Others'\n","\n","#Find Function\n","def find_function(data):\n","  try:\n","    item = data['product_subcategory'] + ' ' + data['product_type'] + ' ' + data['product_title'] + ' ' + str(data['product_description'])\n","  except:\n","    item = ''\n","  functions_producttype = {\n","      'Sexual Wellness': ['Sexual Wellness'],\n","      'Protect': ['Face Masks & Safety Gears'],\n","      'Perfume': [\"Women's Deodorants\",\"Men's Deodorants\",'Talcum Powder','Eau De Toilette','Eau De Parfum', 'Perfume','Eau De Cologne','Body Sprays & Mists','Attar','Talc'],\n","      'Pain Relief': [],\n","      'Wellness': ['Supplements & Proteins','Everyday Medicine'],\n","      'Essentials': ['Antiseptics & Bandages','Sanitary Napkins','Cotton & Ear Buds','Panty Liners', 'Adult Diapers','Tampons & Menstrual Cups'],\n","      'Grooming': ['Hair Care & Styling','Makeup Accessories','Hair Color','Moustache & Beard Care'],\n","      'Cleanse': ['Bathing Bars & Soaps', 'Shower Gel & Body Wash', 'Shaving Care','Hand Wash & Sanitizers','Shampoo & Conditioner','Bath & Shower','Electric Toothbrush', 'Toothpaste', 'Toothbrush', 'Mouthwash','Body Scrubs & Exfoliants','Floss & Tongue Cleaner','Dry Shampoo & Conditioner'],\n","      'Nourish': ['Hair Oil & Serum'],\n","      'Enhance': ['Hair Removal','Aromatherapy','Slimming Products']\n","  }\n","  functions = {\n","      'Sexual Wellness': ['Condom', 'Sexual'],\n","      'Protect': ['Face Mask'],\n","      'Perfume': ['Deo', 'Perfum', 'Eau', 'Talc'],\n","      'Pain Relief': ['Pain', 'Relispray'],\n","      'Wellness': ['Ayurveda', 'Supplement', 'Medicin'],\n","      'Essentials': ['Diaper', 'Sanitary', 'Tampon', 'Hygiene', 'Cotton'],\n","      'Grooming': ['Groom'],\n","      'Cleanse': ['Soap', 'Shampoo', 'Exfoli', 'Scrub', 'Shower', 'Shaving', 'Wash', 'Cleans', 'Toothbrush', 'Toothpaste', 'Oral Care'],\n","      'Enhance': ['Moistur', 'Enhanc'],\n","      'Nourish': ['Hair', 'Nourish', 'Massage', 'Scalp'],\n","      'Enhance': ['Hydrat', 'Lotion', 'Face Care', 'Lip Care', 'Body Care', 'Aroma', 'Smoothen', 'Makeup', 'Skin Care']\n","  }\n","  for function in functions_producttype.keys():\n","    if data['product_type'] in functions_producttype[function]:\n","      return function\n","  for function in functions.keys():\n","    for text in functions[function]:\n","      pattern = r\"\\b\" + re.escape(text.lower())\n","      if re.search(pattern, item.lower()):\n","        return function\n","  return 'Others'\n","\n","df['Part'] = df.apply(find_part, axis = 1)\n","df['Form'] = df.apply(find_form, axis = 1)\n","df['Function'] = df.apply(find_function, axis = 1)\n"],"metadata":{"id":"9eqfHw_V7Fx6"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["In the following section we estimate the expected demand for different products based on a model developed by the team.\n","The demand estimation model takes the selling price and the review counts as the proxy to the actual sale value. It then applies a Percentile Rank on the Value of the products and the number of products available for each brand.\n","\n","This is then enhanced using some factors like economic growth, growth in urban and rural demand, marketing & pricing sensitivity etc. These factors are then used to project the exepected growth in demand for all the products."],"metadata":{"id":"YaJOIJ4so7bC"}},{"cell_type":"code","source":["df['sale_value'] = df['selling_price']*df['customer_reviews_count']\n","df['discount_percent'] = (100*(df['original_price'] - df['selling_price']))/df['original_price']\n","df['ValuePercentileRank'] = df.groupby(['category', 'product_subcategory'])['sale_value'].rank(pct=True)\n","brand_counts = df['brand'].value_counts().reset_index()\n","brand_counts.columns = ['brand', 'count']\n","\n","# Step 2: Merge aggregated count back to original dataframe\n","df = pd.merge(df, brand_counts, on='brand')\n","\n","# Step 3: Calculate percentile rank for every record\n","df['CountPercentileRank'] = df.groupby('brand')['count'].rank(pct=True)"],"metadata":{"id":"6mCm9GgxVAdQ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["common_factors = {\n","            #'share': [0.65, 0.35],\n","            'internet': [.06, .14],\n","            'ecomm': [.28, .4],\n","            'percapita': [.15, .12],\n","            'tech': [.1,.15],\n","            'demo': [.1, .1],\n","            'govt': [.1, .14],\n","            'inflation': [-.05,-.05],\n","            'efficiency': [.1,.1]\n","          }\n","\n","cat_factors = {\n","      'Beauty & Hygiene': {'percapita': 1, 'pricing': .1, 'marketing': .1},\n","      'Kitchen, Garden & Pets': {'percapita': 1, 'pricing': .21, 'marketing': .1},\n","      'Gourmet & World Food': {'percapita': 1, 'pricing': 0, 'marketing': .08},\n","      'Cleaning & Household': {'percapita': 0.8, 'pricing': .02, 'marketing': .08},\n","      'Foodgrains, Oil & Masala': {'percapita': 0.4, 'pricing': .05, 'marketing': 0},\n","      'Snacks & Branded Foods': {'percapita': 0.6, 'pricing': 0, 'marketing': 0},\n","      'Baby Care': {'percapita': 0.8, 'pricing': 0, 'marketing': .05},\n","      'Beverages': {'percapita': 0.6, 'pricing': 0, 'marketing': .05},\n","      'Bakery, Cakes & Dairy': {'percapita': 0.7, 'pricing': 0, 'marketing': 0},\n","      'Eggs, Meat & Fish': {'percapita': 0.4, 'pricing': .02, 'marketing': 0},\n","      'Fruits & Vegetables': {'percapita': 0.4, 'pricing': .2, 'marketing': 0},\n","    }\n","\n","part_factors = {\n","        'Lips': 0.25,\n","        'Mouth': 0.20,\n","        'Eyes': 0.25,\n","        'Hand': 0.15,\n","        'Face': 0.20,\n","        'Hair': 0.15,\n","        'Body': 0.10,\n","        'Wellness': 0.20,\n","        'Feet': 0.15,\n","        'Private Hygiene': 0.10,\n","        'Ears': 0.10,\n","        'Others': 0.00\n","        }\n","\n","#Urban_demand\n","coolingoff_period = 0.9\n","for n_years in range(1,6):\n","  #n_years = 3\n","  urban_impact = 0.65\n","  for i in common_factors:\n","    if i != 'percapita':\n","      urban_impact = urban_impact*((1+(common_factors[i][0]*df['ValuePercentileRank']*df['CountPercentileRank'])*coolingoff_period)**n_years)\n","\n","  urban_percapita = (1+df['Part'].map(lambda x: part_factors[x]))*(1+ (df['category'].map(lambda x: cat_factors[x]['percapita']*common_factors['percapita'][0])*df['ValuePercentileRank']*df['CountPercentileRank'])*coolingoff_period)**n_years\n","\n","  rural_impact = 0.35\n","  for i in common_factors:\n","    if i != 'percapita':\n","      rural_impact = rural_impact*((1+(common_factors[i][1]*df['ValuePercentileRank']*df['CountPercentileRank'])*coolingoff_period)**n_years)\n","  rural_percapita = (1+df['Part'].map(lambda x: part_factors[x]))*(1+ (df['category'].map(lambda x: cat_factors[x]['percapita']*common_factors['percapita'][1])*df['ValuePercentileRank']*df['CountPercentileRank'])*coolingoff_period)**n_years\n","  pricing = (1+(df['category'].map(lambda x: cat_factors[x]['pricing'])*df['ValuePercentileRank']*df['CountPercentileRank'])*coolingoff_period)**n_years\n","  marketing = (1+(df['category'].map(lambda x: cat_factors[x]['marketing'])*df['ValuePercentileRank']*df['CountPercentileRank'])*coolingoff_period)**n_years\n","\n","  df['forecast_demand-'+ str(n_years)] = (urban_impact*urban_percapita*df['sale_value'] + rural_impact*rural_percapita*df['sale_value'])*pricing*marketing\n","  df['demand_uptick-'+ str(n_years)] = (100*(df['forecast_demand-' + str(n_years)] -  df['sale_value']) / df['sale_value'])/n_years"],"metadata":{"id":"ZhOJT75PVAdQ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["df_bh = df[df['category'] == 'Beauty & Hygiene']\n","df_bh.shape"],"metadata":{"executionInfo":{"status":"ok","timestamp":1713759711104,"user_tz":-330,"elapsed":7,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"7fae78dc-cf7f-4d11-ce0e-7e57d6ed2f35","id":"z3vhgCj9VAdR"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["(7867, 35)"]},"metadata":{},"execution_count":8}]},{"cell_type":"markdown","source":["This section extracts the common ingredients from the products and is used to analyse the usage and value realisation of these ingredients"],"metadata":{"id":"MbjpBGvtphkh"}},{"cell_type":"code","source":["product_words = ['Oil', 'Aloe', 'Vera', 'E', 'C', 'Neem', 'Charcoal', 'Tea', 'Almond', 'Rose', 'Amla', 'Argan', 'Coconut', 'Turmeric', 'Lemon', 'Gold', 'Lavender', 'Tree',\n"," 'Butter', 'Honey', 'Orange', 'Milk', 'Keratin', 'Oils', 'Water', 'Cotton', 'Shea', 'Olive', 'Tulsi', 'Saffron', 'Jasmine', 'Sandalwood', 'Cucumber', 'Avocado', 'Sandal',\n"," 'Jojoba', 'Cocoa', 'Seed', 'Bergamot', 'Papaya', 'Salt', 'Apple', 'Pears', 'Brahmi', 'Arden', 'Talc', 'Kaya', 'Ashwagandha', 'Clay', 'Strawberry', 'Pomegranate